JWT_SECRET=your-secret-key-min-32-chars

# These are the DB URLs used by docker-compose for each service.
USER_DATABASE_URL=postgres://postgres:postgres@users-db:5432/users?sslmode=disable
PRODUCT_DATABASE_URL=postgres://postgres:postgres@products-db:5432/products?sslmode=disable
CART_DATABASE_URL=postgres://postgres:postgres@carts-db:5432/carts?sslmode=disable

